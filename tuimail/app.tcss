/* ---- shared -------------------------------------------------------------- */
Screen {
    background: $background;
}
/* Textual's default widget chrome (tall/line borders + surface slabs) renders
   with gaps in macOS Terminal and fights round borders. Own the look instead:
   transparent fields outlined directly on the card, outline-style buttons. */
Input, TextArea, SelectCurrent, Checkbox {
    background: transparent;
    border: round $primary 40%;
}
Input:focus, TextArea:focus, Checkbox:focus, Select:focus SelectCurrent {
    border: round $accent;
    background: $boost;
}
Button {
    margin: 1 2 0 0;
    background: transparent !important;  /* variants re-declare chrome */
    border: round $primary 40% !important;
    text-style: bold;
}
Button:focus {
    border: round $accent !important;
    background: $accent 20% !important;
}
Button.-primary {
    color: $accent;
    border: round $accent 60% !important;
}
Button.-error {
    color: $error;
    border: round $error 60% !important;
}
.hint {
    color: $text-muted;
    margin-top: 1;
}
.card-title {
    text-style: bold;
    color: $accent;
    margin-bottom: 1;
}

/* ---- onboarding / accounts / login ---------------------------------------- */
OnboardingScreen, AccountFormScreen, AccountsScreen, LoginScreen {
    align: center middle;
}
.acct-row {
    margin: 0 0 0 1;
}
#acctlist {
    height: 8;
    border: round $primary 40%;
    margin-bottom: 1;
}
.card {
    width: 74;
    max-width: 100%;
    max-height: 92%;
    padding: 1 3;
    border: round $primary;
    background: $panel;
}
.card Button {
    min-width: 8;
    margin: 1 1 0 0;
}
#logo {
    color: $accent;
    text-style: bold;
    width: 100%;
    content-align: center middle;
    margin-bottom: 1;
}
.tagline {
    width: 100%;
    content-align: center middle;
    color: $text-muted;
    margin-bottom: 1;
}
.card Input, .card Select {
    margin-bottom: 1;
}
.form-card Input, .form-card Select {
    margin-bottom: 0;
}
.buttons {
    height: auto;
    align-horizontal: center;
}
#login-status {
    color: $warning;
    margin-top: 1;
}

/* ---- main screen ---------------------------------------------------------- */
#main-split {
    height: 1fr;
}
#sidebar {
    width: 26;
}
/* two separate panels; the focused one lights up like the message list does */
#accounts, #folders {
    background: transparent;
    border: round $primary 40%;
    border-title-color: $text-muted;
    border-title-style: bold;
    padding: 0 1;
}
#accounts:focus, #folders:focus {
    border: round $accent;
    border-title-color: $accent;
}
/* a tint instead of the stock bright bar: the cyan counts stay readable */
#accounts > ListItem.-highlight, #folders > ListItem.-highlight {
    background: $primary 25%;
}
#accounts:focus > ListItem.-highlight, #folders:focus > ListItem.-highlight {
    background: $primary 50%;
}
#accounts {
    height: auto;
    max-height: 10;
}
#folders {
    height: 1fr;
}
#content {
    width: 1fr;
}
#search {
    display: none;
    border: round $accent;
    margin: 0 0 0 0;
}
#search.visible {
    display: block;
}
#msgtable {
    height: 1fr;
    border: round $primary 40%;
}
#msgtable:focus {
    border: round $accent;
}
#preview-scroll {
    height: 30%;
    min-height: 6;
    border: round $primary 40%;
    padding: 0 1;
}
#preview-scroll:focus {
    border: round $accent;
}

#selbar {
    dock: bottom;
    height: 1;
    padding: 0 1;
    background: $accent 30%;
    display: none;
}

/* ---- reader ---------------------------------------------------------------- */
#reader-scroll {
    padding: 1 2;
}
#reader-md {
    background: transparent;
    padding: 0;
    margin: 0;
}

FilePickScreen {
    align: center middle;
    background: $background 60%;
}
#filepick-card {
    width: 90%;
    max-width: 100;
    height: 85%;
    padding: 1 2;
    border: round $accent;
    background: $panel;
}
#from-row {
    height: auto;
}
#from-row Label {
    width: 7;
    padding: 1 1;
    color: $text-muted;
}
#from-row Select {
    width: 1fr;
}
#ftree {
    height: 1fr;
    background: transparent;
}
#attach-line {
    display: none;
    padding: 0 1;
}

/* ---- compose --------------------------------------------------------------- */
ComposeScreen #body {
    height: 1fr;
    margin-top: 1;
}
ComposeScreen Vertical {
    padding: 1 2;
}
ComposeScreen Input {
    margin-bottom: 0;
}

/* ---- modals ---------------------------------------------------------------- */
ConfirmScreen, HelpScreen, LinksScreen {
    align: center middle;
    background: $background 60%;
}
#confirm-card {
    width: 56;
    height: auto;
    padding: 1 2;
    border: round $error;
    background: $panel;
}
#help-card {
    width: 70;
    max-height: 85%;
    padding: 1 2;
    border: round $accent;
    background: $panel;
}
#links-card {
    width: 76;
    max-height: 70%;
    padding: 1 2;
    border: round $accent;
    background: $panel;
}
